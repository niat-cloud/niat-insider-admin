From 5ef53da534d1983a461e4fc21021720763a03f18 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 1 Aug 2026 06:36:58 +0000
Subject: [PATCH] Add category filter and FAQ/category editing to Q&A
 moderation

Question edit dialog can now toggle FAQ status, FAQ order, and
category (previously title/body only). Adds a category filter
dropdown to the questions list, populated from the existing
public /api/questions/categories/ endpoint.
---
 app/qa/QaClient.tsx | 113 +++++++++++++++++++++++++++++++++++++-------
 lib/api/qa.ts       |   8 ++++
 2 files changed, 104 insertions(+), 17 deletions(-)

diff --git a/app/qa/QaClient.tsx b/app/qa/QaClient.tsx
index bc5a503..12f78c9 100644
--- a/app/qa/QaClient.tsx
+++ b/app/qa/QaClient.tsx
@@ -45,6 +45,7 @@ import {
   createAnswerDirect,
   bulkApproveAnswers,
   bulkRejectAnswers,
+  getQuestionCategories,
   qaErrorMessage,
 } from "@/lib/api/qa";
 import type {
@@ -95,6 +96,8 @@ export function QaClient() {
 
   const [contentType, setContentType] = useState<ContentType>("questions");
   const [statusFilter, setStatusFilter] = useState<StatusFilter>("pending");
+  const [categoryFilter, setCategoryFilter] = useState<string>("");
+  const [categories, setCategories] = useState<string[]>([]);
   const [search, setSearch] = useState("");
   const [debouncedSearch, setDebouncedSearch] = useState("");
   const [page, setPage] = useState(1);
@@ -127,6 +130,9 @@ export function QaClient() {
   const [editMode, setEditMode] = useState(false);
   const [editTitle, setEditTitle] = useState("");
   const [editBody, setEditBody] = useState("");
+  const [editIsFaq, setEditIsFaq] = useState(false);
+  const [editFaqOrder, setEditFaqOrder] = useState(0);
+  const [editCategory, setEditCategory] = useState("");
 
   const [newAnswerBody, setNewAnswerBody] = useState("");
 
@@ -144,7 +150,16 @@ export function QaClient() {
 
   useEffect(() => {
     setPage(1);
-  }, [contentType, statusFilter, debouncedSearch]);
+  }, [contentType, statusFilter, categoryFilter, debouncedSearch]);
+
+  // ---- load category options once (public endpoint) ----
+  useEffect(() => {
+    getQuestionCategories()
+      .then(setCategories)
+      .catch(() => {
+        /* non-critical — filter/edit category fields just show empty list */
+      });
+  }, []);
 
   // ---- fetch list ----
   const fetchList = useCallback(async () => {
@@ -156,6 +171,7 @@ export function QaClient() {
       if (contentType === "questions") {
         const res = await getAdminQuestions({
           status: statusParam,
+          category: categoryFilter || undefined,
           search: debouncedSearch || undefined,
           page,
           ordering: "-created_at",
@@ -184,7 +200,7 @@ export function QaClient() {
     } finally {
       setIsLoading(false);
     }
-  }, [contentType, statusFilter, debouncedSearch, page, toast]);
+  }, [contentType, statusFilter, categoryFilter, debouncedSearch, page, toast]);
 
   useEffect(() => {
     fetchList();
@@ -352,6 +368,9 @@ export function QaClient() {
     if (!detailQuestion) return;
     setEditTitle(detailQuestion.title);
     setEditBody(detailQuestion.body);
+    setEditIsFaq(detailQuestion.is_faq);
+    setEditFaqOrder(detailQuestion.faq_order);
+    setEditCategory(detailQuestion.category ?? "");
     setEditMode(true);
   };
 
@@ -359,7 +378,13 @@ export function QaClient() {
     if (!detailQuestion) return;
     setActionPending(true);
     try {
-      await editQuestion(detailQuestion.slug, { title: editTitle, body: editBody });
+      await editQuestion(detailQuestion.slug, {
+        title: editTitle,
+        body: editBody,
+        is_faq: editIsFaq,
+        faq_order: editFaqOrder,
+        category: editCategory,
+      });
       toast({ title: "Question updated" });
       setEditMode(false);
       await refreshDetailQuestion();
@@ -494,15 +519,31 @@ export function QaClient() {
         ))}
       </div>
 
-      {/* search */}
-      <div className="mb-4 relative">
-        <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-500" />
-        <Input
-          value={search}
-          onChange={(e) => setSearch(e.target.value)}
-          placeholder={`Search ${contentType}...`}
-          className="pl-9"
-        />
+      {/* search + category filter */}
+      <div className="mb-4 flex flex-col gap-3 sm:flex-row">
+        <div className="relative flex-1">
+          <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-500" />
+          <Input
+            value={search}
+            onChange={(e) => setSearch(e.target.value)}
+            placeholder={`Search ${contentType}...`}
+            className="pl-9"
+          />
+        </div>
+        {contentType === "questions" && categories.length > 0 && (
+          <select
+            value={categoryFilter}
+            onChange={(e) => setCategoryFilter(e.target.value)}
+            className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 sm:w-56"
+          >
+            <option value="">All categories</option>
